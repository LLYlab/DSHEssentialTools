    "type": "git",
    "url": "git+https://github.com/LLYlab/DSHEssentialTools.git"
  },
  "homepage": "https://github.com/LLYlab/DSHEssentialTools#readme",
  "bugs": {
    "url": "https://github.com/LLYlab/DSHEssentialTools/issues"
  },
